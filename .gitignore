/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# Local development store. These hold one-time login codes and customer data —
# never commit them. The glob replaces a hand-maintained list that had already
# drifted (admin-auth-codes.json was written but only auth-codes.json ignored).
/data/*.json
/data/*.jsonl
!/data/knowledge-posts-import-report.json
.venv/
.pyenv/
.vscode/
any4k.com-MONGOLIA(AV01_2160p).mp4
mongolia-clips/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
